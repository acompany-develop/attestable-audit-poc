loader.entrypoint.uri = "file:{{ gramine.libos }}"
libos.entrypoint = "{{ entrypoint }}"
loader.log_level = "{{ log_level }}"

loader.env.LD_LIBRARY_PATH = "/lib:{{ arch_libdir }}:/usr/{{ arch_libdir }}"
loader.env.PATH = "/usr/bin:/bin"
loader.env.HOME = "/tmp"
loader.env.LANG = "C.UTF-8"
loader.env.PYTHONDONTWRITEBYTECODE = "1"
loader.env.PYTHONPATH = "/pypkgs"

loader.argv = [
  "python3",
  "/auditor.py",
  "/input/script.py",
  "/output",
]

sys.enable_sigterm_injection = true
sys.stack.size = "2M"

fs.mounts = [
  { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
  { path = "{{ arch_libdir }}", uri = "file:{{ arch_libdir }}" },
  { path = "/usr/{{ arch_libdir }}", uri = "file:/usr/{{ arch_libdir }}" },
  { path = "/usr/lib/python3", uri = "file:/usr/lib/python3" },
  { path = "{{ python.stdlib }}", uri = "file:{{ python.stdlib }}" },
  { path = "{{ python.distlib }}", uri = "file:{{ python.distlib }}" },
  { path = "{{ entrypoint }}", uri = "file:{{ entrypoint }}" },
  { path = "/auditor.py", uri = "file:auditor.py" },
  { path = "/pypkgs", uri = "file:pypkgs" },
  { path = "/input", uri = "file:input" },
  { path = "/output", uri = "file:output" },
  { path = "/tmp", type = "tmpfs" },
]

sgx.debug = true
sgx.edmm_enable = false
sgx.enclave_size = "1G"
sgx.max_threads = 8
sgx.remote_attestation = "dcap"

sgx.trusted_files = [
  "file:{{ gramine.libos }}",
  "file:{{ entrypoint }}",
  "file:{{ gramine.runtimedir() }}/",
  "file:{{ arch_libdir }}/",
  "file:/usr/{{ arch_libdir }}/",
  "file:/usr/lib/python3/",
  "file:{{ python.stdlib }}/",
  "file:{{ python.distlib }}/",
  "file:auditor.py",
  "file:pypkgs/",
]

sgx.allowed_files = [
  "file:input/",
  "file:output/",
]
